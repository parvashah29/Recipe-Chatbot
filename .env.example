# Copy to .env and edit. Everything here is optional.
# Flask session signing key (random per start if unset)
SECRET_KEY=change-me
# Optional: enables Gemini-written health notes. App works without it.
GEMINI_API_KEY=
# Optional: comma-separated Gemini model fallback chain
# GEMINI_MODELS=gemini-3-flash-preview,gemini-3.1-flash-lite
# Set to 0 to skip TheMealDB network calls (offline mode)
# THEMEALDB_ENABLED=1
# Folder of recipe photos (default: ./image_for_cuisines/data). Missing folder is fine.
# RECIPE_IMAGE_DIR=
# DATABASE_URL=sqlite:///recipes.db
# HOST=127.0.0.1
# PORT=5001
# FLASK_DEBUG=0
